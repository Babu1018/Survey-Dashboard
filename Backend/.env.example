DATABASE_URL=postgresql://postgres:password@localhost:5432/Survey-Dashboard
APP_ENV=development
DEBUG=True

# Gmail SMTP (use an App Password, not your regular Gmail password)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password_here
SMTP_FROM=your_email@gmail.com

# Port for the FastAPI server (8000 is often taken by other local services)
PORT=8001

# Authentik SSO login (optional). Leave unset to disable /api/auth/authentik/*
# and keep using local username/password login only. See
# Backend/authentik_auth/README.md for setup steps.
# AUTHENTIK_DOMAIN=https://auth.example.com
# AUTHENTIK_APPLICATION=survey-dashboard
# AUTHENTIK_CLIENT_ID=replace-with-provider-client-id
# AUTHENTIK_CLIENT_SECRET=replace-with-provider-client-secret
# AUTHENTIK_AUDIENCE=replace-with-provider-client-id
# AUTHENTIK_API_TOKEN=replace-with-a-least-privilege-api-token
# AUTHENTIK_AUTH_FLOW=default-authentication-flow
# AUTHENTIK_SCOPES=openid profile email
# AUTHENTIK_ALLOWED_ROLES=Admin,Manager,User
# AUTHENTIK_APP_PASSWORD_PREFIX=survey-dashboard
